{
  "name": "fls",
  "version": "1.5.0",
  "type": "module",
  "description": "fls — lire et modifier des fichiers en une seule commande, sans interaction. Voir SPEC.md.",
  "main": "src/fls.ts",
  "scripts": {
    "build": "bun build --compile src/fls.ts --outfile=dist/fls",
    "build:install": "pnpm run build && pnpm run install:global",
    "install:global": "bash bin/install-fls.sh",
    "test": "pnpm run test:unit && pnpm run test:e2e && pnpm run test:coverage",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run -t '^(?!.*(le binaire fonctionne|realRunner|treecat)).*'",
    "test:e2e": "vitest run -t 'le binaire fonctionne|realRunner|treecat'",
    "uninstall:global": "bash bin/uninstall-fls.sh",
    "version": "node src/fls.ts --version"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "shiki": "4.6.0"
  }
}
